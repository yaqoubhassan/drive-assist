{
    "openapi": "3.0.0",
    "info": {
        "title": "Drive Assist API",
        "description": "API documentation for Drive Assist - AI-powered car diagnostic and expert matching platform",
        "contact": {
            "email": "support@driveassist.com"
        },
        "license": {
            "name": "Proprietary",
            "url": "https://driveassist.com/license"
        },
