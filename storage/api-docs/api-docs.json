                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/diagnosis/vehicles": {
            "get": {
                "tags": [
                    "Diagnosis"
                ],
                "summary": "Get user's vehicles",
                "description": "Retrieve list of vehicles owned by the authenticated user for diagnosis form",
                "operationId": "1542cecae0be1ecbd9e9f95df779ed89",
                "responses": {
                    "200": {
                        "description": "Vehicles retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Vehicles retrieved successfully"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
