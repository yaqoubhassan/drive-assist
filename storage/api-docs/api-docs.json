                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/auth/refresh-token": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Refresh authentication token",
                "operationId": "0bf199e19c06d23a1bf8759c4648856a",
                "responses": {
                    "200": {
                        "description": "Token refreshed successfully",
